generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocType {
  QT    // ใบเสนอราคา
  INV   // ใบแจ้งหนี้
  DN    // ใบส่งสินค้า
  TI    // ใบกำกับภาษี
  RC    // ใบเสร็จรับเงิน
  CN    // ใบลดหนี้
  PO    // ใบสั่งซื้อ
  BILL  // บันทึกค่าใช้จ่าย
}

enum DocStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

enum VatType {
  VAT      // มีภาษี 7%
  NON_VAT  // ยกเว้นภาษี
  ZERO     // อัตรา 0%
}

model Company {
  id        String   @id @default(uuid())
  name      String
  taxId     String?
  branch    String?  @default("สำนักงานใหญ่")
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  vatRate   Decimal  @default(7) @db.Decimal(5, 2)
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id           String    @id @default(uuid())
  sku          String    @unique
  name         String
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  unit         String    @default("ชิ้น")
  costPrice    Decimal   @default(0) @db.Decimal(14, 2)
  sellPrice    Decimal   @default(0) @db.Decimal(14, 2)
  vatType      VatType   @default(VAT)
  stockQty     Decimal   @default(0) @db.Decimal(14, 3)
  reorderPoint Decimal   @default(0) @db.Decimal(14, 3)
  isService    Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items      DocumentItem[]
  stockMoves StockMove[]

  @@index([name])
}

model Contact {
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  type       ContactType @default(CUSTOMER)
  taxId      String?
  branch     String?     @default("สำนักงานใหญ่")
  address    String?
  phone      String?
  email      String?
  creditDays Int         @default(30)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())

  documents Document[]

  @@index([name])
}

model Document {
  id         String    @id @default(uuid())
  docType    DocType
  docNo      String    @unique
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id])
  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  status     DocStatus @default(DRAFT)

  parentId String?
  parent   Document?  @relation("DocChain", fields: [parentId], references: [id])
  children Document[] @relation("DocChain")

  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  discount   Decimal @default(0) @db.Decimal(14, 2)
  vatAmount  Decimal @default(0) @db.Decimal(14, 2)
  whtRate    Decimal @default(0) @db.Decimal(5, 2)
  whtAmount  Decimal @default(0) @db.Decimal(14, 2)
  grandTotal Decimal @default(0) @db.Decimal(14, 2)
  cogs       Decimal @default(0) @db.Decimal(14, 2)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      DocumentItem[]
  journals   JournalEntry[]
  stockMoves StockMove[]

  @@index([docType, status])
  @@index([issueDate])
}

model DocumentItem {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  qty         Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  amount      Decimal  @db.Decimal(14, 2)
  unitCost    Decimal  @default(0) @db.Decimal(14, 2)
  vatType     VatType  @default(VAT)
  lineNo      Int      @default(1)
}

model Account {
  code  String      @id
  name  String
  type  AccountType
  lines JournalLine[]

  @@index([type])
}

model JournalEntry {
  id          String   @id @default(uuid())
  entryNo     String   @unique
  entryDate   DateTime
  refDocId    String?
  refDoc      Document? @relation(fields: [refDocId], references: [id])
  description String
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@index([entryDate])
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode String
  account     Account      @relation(fields: [accountCode], references: [code])
  debit       Decimal      @default(0) @db.Decimal(14, 2)
  credit      Decimal      @default(0) @db.Decimal(14, 2)

  @@index([accountCode])
}

model StockMove {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  qty        Decimal  @db.Decimal(14, 3) // + เข้า / - ออก
  unitCost   Decimal  @default(0) @db.Decimal(14, 2)
  reason     String
  movedAt    DateTime @default(now())

  @@index([productId])
}

model DocSequence {
  key     String @id // "QT-2026"
  current Int    @default(0)
}
